# Workspace environment. Copy to .env at the workspace root and fill in. Never commit .env.
# In production, inject these from a secrets manager (Azure Key Vault, GCP Secret Manager, ...).

# ============================================================================
# Shared LLM settings (used by every agent, read by agents_core.llm.LLMSettings)
# ============================================================================

# Default backend for all agents: azure_openai | gemini | openai_compatible
LLM_PROVIDER=azure_openai
# Set to "none" for models that reject a temperature (e.g. reasoning models).
LLM_TEMPERATURE=0.2

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
AZURE_OPENAI_API_VERSION=2024-10-21
# Leave empty to authenticate with Microsoft Entra ID (DefaultAzureCredential) instead of a key.
AZURE_OPENAI_API_KEY=

# --- Gemini (Google AI Studio key, or Vertex AI with application default credentials) ---
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_USE_VERTEX=false
GEMINI_PROJECT=
GEMINI_LOCATION=asia-south1

# --- Any OpenAI-compatible server (OpenAI, Ollama, vLLM, LM Studio, ...) ---
# Free, open-weight option for Indian languages: run Gemma (Apache-2.0) or Sarvam-M/Sarvam-30B
# (Apache-2.0) yourself, e.g. with Ollama: OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=<model tag>
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# ============================================================================
# Shared speech settings (voice notes), read by agents_core.speech.SpeechSettings
# ============================================================================

# none | azure | bhashini   ("bhashini" also works with a self-hosted AI4Bharat Dhruva-Platform server)
SPEECH_PROVIDER=none
# Language for voice notes before we know the person's language (ISO code: hi, ta, bn, te, mr, ...)
SPEECH_DEFAULT_LANGUAGE=hi
# Also reply with a voice message when someone sends a voice note
SPEECH_VOICE_REPLIES=true

# --- Azure AI Speech (free F0 tier: 5 audio hours speech-to-text and 0.5M characters text-to-speech a month)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia
# Optional JSON to change voices, e.g. {"hi": "hi-IN-MadhurNeural"}
AZURE_SPEECH_VOICES=

# --- Bhashini (https://dashboard.bhashini.co.in; free API access is meant for proof-of-concept use,
# confirm production terms with the Bhashini team). IDs are on your Bhashini "My Profile" page.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
# Self-hosted Dhruva-Platform instead of hosted Bhashini: set the URL, key and serviceIds, e.g.
# BHASHINI_SERVICE_IDS={"asr:hi": "ai4bharat/conformer-hi-gpu--t4", "tts:hi": "ai4bharat/indic-tts-coqui-indo_aryan-gpu--t4"}
BHASHINI_INFERENCE_URL=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_SERVICE_IDS=

# ============================================================================
# Agent: saathi (welfare schemes)
# ============================================================================

# Optional: use a different provider for this agent only (overrides LLM_PROVIDER).
SAATHI_LLM_PROVIDER=

# --- Web app ---
# development | production. Production refuses unsafe settings (console SMS, weak secret, insecure cookies).
SAATHI_ENVIRONMENT=development
# What the browser sees; used for Google OAuth redirects.
SAATHI_PUBLIC_URL=http://localhost:8080
# Random 32+ characters, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SAATHI_SECRET_KEY=
# Database password used by docker compose (generate one the same way). Never reuse in production.
SAATHI_DB_PASSWORD=admin@123
# For running the backend outside Docker (saathi serve):
# SAATHI_DATABASE_URL=postgresql+asyncpg://saathi:<password>@localhost:5432/saathi
# Comma-separated Google emails that become admins on first sign-in.
SAATHI_ADMIN_EMAILS=admin@example.com
# Only schemes marked verified are shown when false. Keep true until the seed data has been reviewed.
SAATHI_INCLUDE_DRAFT_SCHEMES=true
# Chat limits (web and WhatsApp together). Each message costs two LLM calls, plus speech for voice
# notes, and anyone can message the WhatsApp bot. The global cap is per rolling 24 hours; 0 = off.
SAATHI_CHAT_LIMIT_PER_10_MINUTES=20
SAATHI_CHAT_LIMIT_PER_DAY=150
SAATHI_CHAT_GLOBAL_LIMIT_PER_DAY=20000

# Google sign-in: create an OAuth client (Web application) in Google Cloud Console with the
# redirect URI  <SAATHI_PUBLIC_URL>/api/auth/google/callback
SAATHI_GOOGLE_CLIENT_ID=
SAATHI_GOOGLE_CLIENT_SECRET=

# OTP SMS: "console" logs codes (development only); "twilio" sends real SMS.
SAATHI_SMS_PROVIDER=console
SAATHI_TWILIO_ACCOUNT_SID=
SAATHI_TWILIO_AUTH_TOKEN=
SAATHI_TWILIO_FROM_NUMBER=

# WhatsApp Business Cloud API (the webhook is disabled until all four are set)
SAATHI_WHATSAPP_VERIFY_TOKEN=
SAATHI_WHATSAPP_APP_SECRET=
SAATHI_WHATSAPP_ACCESS_TOKEN=
SAATHI_WHATSAPP_PHONE_NUMBER_ID=
SAATHI_WHATSAPP_GRAPH_VERSION=v21.0
# The bot's number, international format without "+" (e.g. 919876543210). Enables
# "Sign in with WhatsApp" on the website: free, because messages people send to the bot cost nothing.
SAATHI_WHATSAPP_LOGIN_NUMBER=

# ---------------------------------------------------------------- HireFinch (apps/hirefinch)
# Uses the shared LLM settings above only when "use LLM for tailoring" is switched on; everything
# works deterministically without an LLM. HIREFINCH_LLM_PROVIDER overrides LLM_PROVIDER for it.
HIREFINCH_LLM_PROVIDER=
HIREFINCH_ENVIRONMENT=development
# Required in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HIREFINCH_SECRET_KEY=
# Accounts: this email becomes the superadmin when it signs up (or run `hirefinch create-superadmin`).
HIREFINCH_SUPERADMIN_EMAIL=
# Encrypts users' stored secrets (SMTP passwords, AI keys). Required in production; keep a copy in a
# password manager: without it stored secrets cannot be read. Comma-separate to rotate (newest first).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HIREFINCH_ENCRYPTION_KEYS=
# Optional: shared sign-in rate limits for several backend instances (set automatically by docker-compose.prod.yml).
HIREFINCH_REDIS_URL=
# Production: public host name served over HTTPS by Caddy (docker-compose.prod.yml).
HIREFINCH_DOMAIN=
HIREFINCH_COOKIE_SECURE=false
# Default: SQLite in apps/hirefinch/data. For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/hirefinch
HIREFINCH_DATABASE_URL=
HIREFINCH_DB_PASSWORD=
HIREFINCH_SCHEDULER_ENABLED=true
# Comma-separated folders the "find my resume" helper may list (names only), e.g. ~/Documents,~/Downloads
HIREFINCH_RESUME_SEARCH_PATHS=
# The email/SMTP/Gmail/Adzuna values below are only read by `hirefinch import-env-integrations`, which
# copies them into one account's encrypted settings. Users set their own in the app (Integrations).
HIREFINCH_EMAIL_PROVIDER=file
HIREFINCH_EMAIL_FROM=
HIREFINCH_SMTP_HOST=
HIREFINCH_SMTP_PORT=587
HIREFINCH_SMTP_USERNAME=
# For Gmail SMTP use an App Password, never your account password.
HIREFINCH_SMTP_PASSWORD=
HIREFINCH_GMAIL_CLIENT_ID=
HIREFINCH_GMAIL_CLIENT_SECRET=
# OAuth refresh token with only the https://www.googleapis.com/auth/gmail.send scope.
HIREFINCH_GMAIL_REFRESH_TOKEN=
# Adzuna job search API (free key: https://developer.adzuna.com)
HIREFINCH_ADZUNA_APP_ID=
HIREFINCH_ADZUNA_APP_KEY=
# Extra hosts the fetcher may contact, comma-separated (career page hosts are approved by adding the page).
HIREFINCH_HTTP_ALLOWED_HOSTS=
HIREFINCH_HTTP_PORT=8090
